+        int digits = 0;
+        for (auto i = sp + 1; i < line.size(); ++i) {
+                auto c = line[i];
+                if (c < '0' || c > '9') {
+                        break;
+                }
+                value = value * 10 + (c - '0');
+                if (++digits == 3) {
