+int http_status_code(const std::string &response)
+{
+        auto eol = response.find('\n');
+        if (eol == std::string::npos) {
+                return 0;
+        }
+        auto line = response.substr(0, eol);
+        auto sp = line.find(' ');
+        if (sp == std::string::npos) {
+                return 0;
+        }
