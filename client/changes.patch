+                {L"速率",             100, true},
+                {L"厂商",             220, true},
+                {L"产品",             220, false},
+                {L"状态",             130, false},
+                {L"自动",             100, false},
+                {L"备注",             360, false},
+                {L"设备ID",           150, true},
+                {L"序列号",           220, true},
+                {L"接收模式",         160, true},
+                {L"源ID",             120, true},
+                {L"服务器备注",       260, true},
+                {L"占用方",           200, true},
+        };
+
+        int changed{};
+        for (const auto &item: columns) {
+                if (auto col = find_column(item.title)) {
+                        if (item.hide && !col->IsHidden()) {
