+        }
+
+        struct default_column {
+                const wchar_t *title;
+                int width;
+                bool hide;
+        };
+
+        /*
+         * 默认只保留日常连接真正需要的信息:
+         *   服务器/总线号 + 产品 + 状态 + 自动 + 备注
+         *
+         * 设备列表现在不是把 14 列平均摊开,而是给常用信息更充足的宽度。
+         * 低频列仍然可以从"视图 -> 列"随时打开,只是首次使用时不占屏幕:
+         *   端口/速率/厂商       - 硬件拓扑与 USB 描述信息,大多数时候不需要
+         *   序列号/接收模式      - 高级诊断/设备区分信息
