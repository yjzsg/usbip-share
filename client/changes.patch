+CLI11_INLINE std::string indent_block(const std::string &input, const std::string &indent) {
+    std::stringstream out;
+    bool line_start = true;
+
+    for(char ch : input) {
+        if(line_start && ch != '\n') {
+            out << indent;
+        }
+        out << ch;
+        line_start = (ch == '\n');
+    }
+
+    return out.str();
+}
