+
+        auto host = m_comboBoxServer->GetValue();
+        if (host.empty()) {
+                return;
+        }
+
+        CallAfter([this]
+        {
+                m_auto_connecting = true;
+                wxCommandEvent evt;
+                add_exported_devices(evt);
+                m_auto_connecting = false;
+        });
+}
