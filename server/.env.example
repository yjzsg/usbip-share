# Copy this file to .env. The Chinese NAS page can share devices interactively.
TZ=Asia/Shanghai

# USB/IP data service. Windows USBip client connects to this port.
USBIP_PORT=5555
USBIP_HOST_PORT=5555
USBIP_HOST_BIND=0.0.0.0

# Optional devices to share immediately at startup. Examples:
# USBIP_BUSIDS=1-1
# USBIP_BUSIDS=1-1,1-2.3
USBIP_BUSIDS=

# The Chinese NAS management page.
USBIP_WEB_ENABLED=true
USBIP_WEB_PORT=8080
USBIP_WEB_HOST_PORT=18080
USBIP_WEB_HOST_BIND=0.0.0.0
# Strongly recommended when port 8080 is reachable by other users.
USBIP_WEB_TOKEN=

# 管理密码。留空 = 首次启动生成 12 位随机密码,写入 ./config/initial-password.txt
# (权限 0600)并打印在 docker compose logs 里;此时页面会强制先改密。
# 设置后密码由本变量托管:每次启动都用它同步 auth.json(不再强制改密),
# 页面上的「修改密码」会被隐藏。至少 8 位,建议 12 位以上。
USBIP_WEB_PASSWORD=

# 共享访问密码(访问控制)。留空 = 关闭(默认):任何客户端都能直接连接,
# 行为与旧版完全一致。设置后:客户端必须先用这个密码调 /api/access/authorize,
# 服务端把它的**来源 IP** 记入授权表并给一个有效期,之后它的 USB/IP 数据连接
# 才会被放行;未授权来源的连接在网关处直接被断开。
# 注意:授权按来源 IP 记账,同一个出口 IP(例如 NAT 后)的多台机器共享一份授权;
# 密码本身仍是明文 HTTP 传输,只在可信内网使用。
USBIP_ACCESS_PASSWORD=
# 授权有效期(秒),默认 43200 = 12 小时。客户端每拍心跳都会续期,所以只要它
# 还在运行就不会掉线;容器重启会清空授权表,客户端需要重新授权。
USBIP_ACCESS_TTL_SECONDS=43200
# 授权表路径(web.py 写、gateway.py 读;文件存在 = 访问控制开启)。
USBIP_ACCESS_FILE=/run/usbip/authorized-clients.json

# 单端口网关的监听地址(对外唯一端口)。默认 0.0.0.0;若只允许本机/内网某网卡访问,
# 可改成具体地址,例如 192.168.1.10。修改后需 docker compose up -d 重建容器。
USBIP_GATEWAY_HOST=0.0.0.0

# Persistent server-side device names and remarks.
USBIP_METADATA_FILE=/etc/usbip/device-metadata.json
# Online client presence is intentionally ephemeral and resets with the container.
USBIP_CLIENTS_FILE=/run/usbip/clients.json
# Release a shared device when its client stops heartbeating this long (seconds).
# Default 60; the Chinese client heartbeats every 10s. Set 0 to disable the watchdog.
USBIP_KICK_IDLE_SECONDS=60

# The Linux host must have usbip_host. The container attempts modprobe by default.
USBIP_LOAD_MODULE=true

# Keep false unless you specifically want managed devices returned to their original
# driver whenever this container stops. A connected client should be detached first.
USBIP_UNBIND_ON_EXIT=false

# Set true only while diagnosing startup/protocol problems.
USBIPD_DEBUG=false
