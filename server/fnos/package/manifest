appname                    = usbip-share
version                    = 1.3.2
display_name               = USB-SHARE
desc                       = 基于内核 USB/IP 协议的 USB 设备网络共享服务。将飞牛上的 USB 设备（加密狗、绘图锁、网银 U 盾、串口设备等）共享给局域网内的 Windows 电脑，在远端如同本地接入一般使用。<br><br>数据通道与管理页面共用同一个端口：Windows 客户端连接该端口，飞牛桌面小窗打开的是同一端口上的管理页，仅需对外开放一个端口。<br><br>设备名称与备注绑定硬件标识（序列号 → 型号指纹 → 同型号序号），更换 USB 插口不会导致名称错乱；支持占用方显示、等待名单排队、强制断开与设备隐藏。<br><br>可选共享访问密码：启用后客户端须先通过密码验证方可连接数据端口。安装后可在「应用设置」中调整服务端口、管理页密码、共享访问密码、重启恢复策略与客户端失联释放时间。<br><br>协议实现基于开源 USB/IP（Linux 内核 usbip 与 usbip-win2）。
platform                   = x86
source                     = thirdparty
maintainer                 = Jiuzee
maintainer_url             = https://github.com/yjzsg/usbip-share
distributor                = Jiuzee
distributor_url            = https://github.com/yjzsg/usbip-share
os_min_version             = 1.1.8
ctl_stop                   = true
