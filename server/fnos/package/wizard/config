[
    {
        "stepTitle": "服务端口",
        "items": [
            {
                "type": "tips",
                "helpText": "改完保存后应用会自动重启（正在使用的 USB/IP 连接会短暂断开）。当前生效端口见飞牛「文件管理」里的 <code>应用安装存储空间/@appconf/usbip-share/usbip-share.env</code>。"
            },
            {
                "type": "text",
                "field": "port",
                "label": "服务端口",
                "initValue": "",
                "helpText": "1-65535。留空表示保持当前值不变。",
                "rules": [
                    {
                        "pattern": "^$|^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "留空表示不修改；否则请输入 1-65535 之间的端口号"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "管理页密码",
        "items": [
            {
                "type": "tips",
                "helpText": "留空表示不修改密码。密码由应用配置托管，改完保存后应用会自动重启。"
            },
            {
                "type": "password",
                "field": "admin_password",
                "label": "新密码（留空不改）",
                "initValue": "",
                "helpText": "8-64 位。",
                "rules": [
                    {
                        "pattern": "^$|^.{8,64}$",
                        "message": "留空表示不修改；否则长度需为 8-64 位"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "共享访问密码",
        "items": [
            {
                "type": "tips",
                "helpText": "启用后客户端连上来必须先输密码。想改密码就选「启用」并在下面填新的；想取消就选「关闭」。"
            },
            {
                "type": "radio",
                "field": "access_mode",
                "label": "共享访问密码",
                "initValue": "keep",
                "options": [
                    {
                        "label": "保持不变",
                        "value": "keep"
                    },
                    {
                        "label": "启用 / 修改密码（在下面填新密码）",
                        "value": "enable"
                    },
                    {
                        "label": "关闭（清空密码，任何客户端都能连）",
                        "value": "disable"
                    }
                ]
            },
            {
                "type": "password",
                "field": "access_password",
                "label": "新访问密码",
                "initValue": "",
                "helpText": "8-64 位。选「保持不变」时留空；选「启用」时留空表示沿用当前密码（当前没有密码则必须填）。",
                "rules": [
                    {
                        "pattern": "^$|^.{8,64}$",
                        "message": "留空表示不修改；否则长度需为 8-64 位"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "设备共享与回收",
        "items": [
            {
                "type": "tips",
                "helpText": "要共享哪些设备在管理页里点，不需要在这里填。下面三项都默认「保持不变」——表单里显示的是默认动作，不是当前值，所以不动它就不会改到现有设置。"
            },
            {
                "type": "radio",
                "field": "restore_shared",
                "label": "重启后自动恢复上次共享的设备",
                "initValue": "keep",
                "options": [
                    {
                        "label": "保持不变",
                        "value": "keep"
                    },
                    {
                        "label": "打开",
                        "value": "enable"
                    },
                    {
                        "label": "关闭",
                        "value": "disable"
                    }
                ]
            },
            {
                "type": "radio",
                "field": "load_module",
                "label": "启动时加载宿主内核模块 usbip_host",
                "initValue": "keep",
                "options": [
                    {
                        "label": "保持不变",
                        "value": "keep"
                    },
                    {
                        "label": "打开",
                        "value": "enable"
                    },
                    {
                        "label": "关闭",
                        "value": "disable"
                    }
                ]
            },
            {
                "type": "radio",
                "field": "unbind_on_exit",
                "label": "停止应用时把 USB 设备归还给原驱动",
                "initValue": "keep",
                "options": [
                    {
                        "label": "保持不变",
                        "value": "keep"
                    },
                    {
                        "label": "打开（请先断开已连接的 Windows 客户端）",
                        "value": "enable"
                    },
                    {
                        "label": "关闭",
                        "value": "disable"
                    }
                ]
            },
            {
                "type": "text",
                "field": "kick_idle_seconds",
                "label": "客户端失联多久后自动释放其设备（秒）",
                "initValue": "",
                "helpText": "填 0 表示不自动释放。留空保持当前值。",
                "rules": [
                    {
                        "pattern": "^$|^[0-9]{1,6}$",
                        "message": "留空表示不修改；否则只能填数字"
                    }
                ]
            }
        ]
    }
]
