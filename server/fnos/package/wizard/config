[
    {
        "stepTitle": "服务端口",
        "items": [
            {
                "type": "tips",
                "helpText": "改完保存后应用会自动重启（正在使用的 USB/IP 连接会短暂断开）。"
            },
            {
                "type": "text",
                "field": "port",
                "label": "服务端口",
                "initValue": "5555",
                "helpText": "1-65535。USB/IP 数据协议与中文管理页共用这一个端口。",
                "rules": [
                    {
                        "required": true,
                        "message": "请输入服务端口"
                    },
                    {
                        "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "请输入 1-65535 之间的端口号"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "管理页密码",
        "items": [
            {
                "type": "tips",
                "helpText": "留空表示不修改密码。密码由应用配置托管，改完保存后应用会自动重启。"
            },
            {
                "type": "password",
                "field": "admin_password",
                "label": "新密码（留空不改）",
                "initValue": "",
                "helpText": "6-64 位。",
                "rules": [
                    {
                        "pattern": "^$|^.{6,64}$",
                        "message": "留空表示不修改；否则长度需为 6-64 位"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "共享访问密码",
        "items": [
            {
                "type": "tips",
                "helpText": "启用后客户端连上来必须先输密码；关闭则任何客户端都能直接连。"
            },
            {
                "type": "radio",
                "field": "access_mode",
                "label": "共享访问密码",
                "initValue": "disable",
                "options": [
                    {
                        "label": "关闭（任何客户端都能连）",
                        "value": "disable"
                    },
                    {
                        "label": "启用（客户端连接时要输入密码）",
                        "value": "enable"
                    }
                ]
            },
            {
                "type": "password",
                "field": "access_password",
                "label": "访问密码",
                "initValue": "",
                "helpText": "6-64 位。留空表示不改密码；选「启用」且当前还没有密码时必须填。",
                "rules": [
                    {
                        "pattern": "^$|^.{6,64}$",
                        "message": "留空表示不修改；否则长度需为 6-64 位"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "设备共享与回收",
        "items": [
            {
                "type": "tips",
                "helpText": "要共享哪些设备在管理页里点，不需要在这里填。"
            },
            {
                "type": "radio",
                "field": "restore_shared",
                "label": "重启后自动恢复上次共享的设备",
                "initValue": "true",
                "options": [
                    {
                        "label": "打开（推荐：重启后自动恢复，不用每次重新点）",
                        "value": "true"
                    },
                    {
                        "label": "关闭（每次启动都是「不共享任何设备」）",
                        "value": "false"
                    }
                ]
            },
            {
                "type": "radio",
                "field": "load_module",
                "label": "启动时加载宿主内核模块 usbip_host",
                "initValue": "true",
                "options": [
                    {
                        "label": "打开（推荐）",
                        "value": "true"
                    },
                    {
                        "label": "关闭（你自己在飞牛宿主上 modprobe usbip_host）",
                        "value": "false"
                    }
                ]
            },
            {
                "type": "radio",
                "field": "unbind_on_exit",
                "label": "停止应用时把 USB 设备归还给原驱动",
                "initValue": "false",
                "options": [
                    {
                        "label": "关闭（推荐：停止应用后设备仍保持绑定）",
                        "value": "false"
                    },
                    {
                        "label": "打开（停止应用时归还给原驱动；请先断开已连接的 Windows 客户端）",
                        "value": "true"
                    }
                ]
            },
            {
                "type": "text",
                "field": "kick_idle_seconds",
                "label": "客户端失联多久后自动释放其设备（秒）",
                "initValue": "60",
                "helpText": "填 0 表示不自动释放。",
                "rules": [
                    {
                        "required": true,
                        "message": "请填写秒数，不需要自动释放就填 0"
                    },
                    {
                        "pattern": "^[0-9]{1,6}$",
                        "message": "只能填数字"
                    }
                ]
            }
        ]
    }
]
