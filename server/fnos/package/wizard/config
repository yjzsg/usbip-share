[
    {
        "stepTitle": "服务端口",
        "items": [
            {
                "type": "tips",
                "helpText": "改完保存后应用会自动重启（正在使用的 USB/IP 连接会短暂断开）。当前生效端口见飞牛「文件管理」里的 <code>应用安装存储空间/@appconf/usbip-share/usbip-share.env</code>。"
            },
            {
                "type": "text",
                "field": "port",
                "label": "服务端口",
                "initValue": "",
                "helpText": "1-65535。留空表示保持当前值不变。",
                "rules": [
                    {
                        "pattern": "^$|^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "留空表示不修改；否则请输入 1-65535 之间的端口号"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "管理页密码",
        "items": [
            {
                "type": "tips",
                "helpText": "留空表示不修改密码。密码由应用配置托管，改完保存后应用会自动重启。"
            },
            {
                "type": "password",
                "field": "admin_password",
                "label": "新密码（留空不改）",
                "initValue": "",
                "helpText": "8-64 位。",
                "rules": [
                    {
                        "pattern": "^$|^.{8,64}$",
                        "message": "留空表示不修改；否则长度需为 8-64 位"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "共享访问密码",
        "items": [
            {
                "type": "tips",
                "helpText": "开启后客户端必须先输入这个密码才能连上 USB/IP 数据端口。关掉开关即清空密码、恢复成「任何客户端都能连」。"
            },
            {
                "type": "switch",
                "field": "access_enabled",
                "label": "启用共享访问密码",
                "initValue": "false",
                "helpText": "关掉会清空已设置的访问密码。"
            },
            {
                "type": "password",
                "field": "access_password",
                "label": "新访问密码（留空不改）",
                "initValue": "",
                "helpText": "8-64 位。留空表示沿用当前密码。",
                "rules": [
                    {
                        "pattern": "^$|^.{8,64}$",
                        "message": "留空表示不修改；否则长度需为 8-64 位"
                    }
                ]
            }
        ]
    },
    {
        "stepTitle": "设备与回收",
        "items": [
            {
                "type": "tips",
                "helpText": "要共享哪些设备在管理页里点，不需要在这里填。"
            },
            {
                "type": "switch",
                "field": "restore_shared",
                "label": "重启后自动恢复上次共享的设备",
                "initValue": "true",
                "helpText": "关闭后每次启动都是「不共享任何设备」。"
            },
            {
                "type": "switch",
                "field": "load_module",
                "label": "启动时加载宿主内核模块 usbip_host",
                "initValue": "true"
            },
            {
                "type": "switch",
                "field": "unbind_on_exit",
                "label": "停止应用时把 USB 设备归还给原驱动",
                "initValue": "false"
            },
            {
                "type": "text",
                "field": "kick_idle_seconds",
                "label": "客户端失联多久后自动释放其设备（秒）",
                "initValue": "",
                "helpText": "填 0 表示不自动释放。留空保持当前值。",
                "rules": [
                    {
                        "pattern": "^$|^[0-9]{1,6}$",
                        "message": "留空表示不修改；否则只能填数字"
                    }
                ]
            }
        ]
    }
]
